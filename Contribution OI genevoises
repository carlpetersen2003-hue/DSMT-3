// â”€â”€ SECTION SANTÃ‰ â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const COLOR_ONU_AGG   = '#2c7a8a';
const COLOR_FONDS_AGG = '#1a7a5e';
let onuAggregated = true;
let fondsAggregated = true;
const onuChecked = new Set();
const fondsChecked = new Set();
let santePieChart = null;

function santeGetVal(entity, year) {
  return santeData[entity]?.[year] || santeData[entity]?.[String(year)] || 0;
}
function santeGetTotal(entity) {
  return santeYears.reduce((s, y) => s + santeGetVal(entity, y), 0);
}
function santeGetAmount(entity) {
  const mode = document.getElementById('santePieMode').value;
  return mode === 'total' ? santeGetTotal(entity) : santeGetVal(entity, parseInt(mode));
}
function santeGroupTotal(group) {
  const list = group === 'onu' ? santeONU : santeFonds;
  return list.reduce((s, e) => s + santeGetAmount(e), 0);
}
function santeLabel() {
  const mode = document.getElementById('santePieMode').value;
  return mode === 'total' ? `Total ${santeYears[0]}â€“${santeYears[santeYears.length-1]}` : String(mode);
}

function isSanteNull(entity, year) {
  const d = santeData[entity]?.[year] ?? santeData[entity]?.[String(year)];
  return d === null || d === undefined;
}

function getSanteExportEntities() {
  const entities = [];
  if (onuAggregated) {
    entities.push({ label: 'Total OI genevoises', isAggregate: true, group: 'onu' });
  } else {
    santeONU.forEach(e => { if (onuChecked.has(e)) entities.push({ label: e, isAggregate: false, group: 'onu' }); });
  }
  if (fondsAggregated) {
    entities.push({ label: 'Total fonds verticaux', isAggregate: true, group: 'fonds' });
  } else {
    santeFonds.forEach(e => { if (fondsChecked.has(e)) entities.push({ label: e, isAggregate: false, group: 'fonds' }); });
  }
  return entities;
}

function exportSanteCsv() {
  const entities = getSanteExportEntities();
  const onuLabel = onuAggregated ? 'Total OI genevoises' : (onuChecked.size ? [...onuChecked].join(', ') : 'Aucune');
  const fondsLabel = fondsAggregated ? 'Total fonds verticaux' : (fondsChecked.size ? [...fondsChecked].join(', ') : 'Aucun');

  const lines = [
    'Section;SantÃ© â€” Contributions franÃ§aises OI genevoises & fonds verticaux',
    'Type;AC + VC',
    'Pays;France',
    `OI genevoises;${csvEscape(onuLabel)}`,
    `Fonds verticaux;${csvEscape(fondsLabel)}`,
    `PÃ©riode;${santeYears[0]} â€“ ${santeYears[santeYears.length - 1]}`,
    'Devise;USD',
    '',
    ['EntitÃ©', 'Groupe', ...santeYears.map(String), 'Total'].join(';')
  ];

  const totals = santeYears.map(() => 0);
  let grandTotal = 0;

  entities.forEach(item => {
    const yearVals = {};
    santeYears.forEach(y => { yearVals[y] = 0; });
    if (item.isAggregate) {
      const list = item.group === 'onu' ? santeONU : santeFonds;
      list.forEach(e => santeYears.forEach(y => { yearVals[y] += santeGetVal(e, y); }));
    } else {
      santeYears.forEach(y => { yearVals[y] = santeGetVal(item.label, y); });
    }
    const rowTotal = santeYears.reduce((s, y) => s + yearVals[y], 0);
    santeYears.forEach((y, i) => { totals[i] += yearVals[y]; });
    grandTotal += rowTotal;

    const vals = santeYears.map(y => {
      if (!item.isAggregate && isSanteNull(item.label, y)) return 'N/D';
      return yearVals[y] === 0 ? '0' : String(yearVals[y]);
    });
    const group = item.isAggregate
      ? (item.group === 'onu' ? 'OI genevoises' : 'Fonds verticaux')
      : (santeFonds.includes(item.label) ? 'Fonds verticaux' : 'OI genevoises');
    lines.push([csvEscape(item.label), csvEscape(group), ...vals, rowTotal === 0 ? '0' : String(rowTotal)].join(';'));
  });

  if (entities.length > 0) {
    lines.push(['Total sÃ©lection', '', ...totals.map(t => t === 0 ? '0' : String(t)), grandTotal === 0 ? '0' : String(grandTotal)].join(';'));
  }

  const blob = new Blob(['\uFEFF' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `contributions-sante-france_${santeYears[0]}-${santeYears[santeYears.length - 1]}.csv`;
  a.click();
  URL.revokeObjectURL(a.href);
}

function toggleAggregate(group, chipEl, cb) {
  if (group === 'onu') onuAggregated = cb.checked;
  else fondsAggregated = cb.checked;
  chipEl.classList.toggle('checked', cb.checked);
  chipEl.style.background = cb.checked ? (group === 'onu' ? COLOR_ONU_AGG : COLOR_FONDS_AGG) : '';
  chipEl.style.borderColor = cb.checked ? (group === 'onu' ? COLOR_ONU_AGG : COLOR_FONDS_AGG) : '';
  renderDetailChips();
  updateSante();
}

function renderDetailChips() {
  const onuPicker = document.getElementById('santeONUpicker');
  const fondsPicker = document.getElementById('santeFondsPicker');
  onuPicker.querySelectorAll('.detail-chip').forEach(c => c.remove());
  fondsPicker.querySelectorAll('.detail-chip').forEach(c => c.remove());

  if (!onuAggregated) {
    santeONU.forEach((e, i) => {
      const color = santeColors[(2 + i) % santeColors.length];
      const checked = onuChecked.has(e);
      const chip = document.createElement('label');
      chip.className = 'entity-chip detail-chip' + (checked ? ' checked' : '');
      chip.style.background = checked ? color : '';
      chip.style.borderColor = checked ? color : '';
      chip.innerHTML = `<input type="checkbox" value="${e}" ${checked?'checked':''}>${e}`;
      chip.querySelector('input').addEventListener('change', function() {
        if (this.checked) onuChecked.add(e); else onuChecked.delete(e);
        chip.classList.toggle('checked', this.checked);
        chip.style.background = this.checked ? color : '';
        chip.style.borderColor = this.checked ? color : '';
        updateSante();
      });
      onuPicker.appendChild(chip);
    });
  }

  if (!fondsAggregated) {
    santeFonds.forEach((e, i) => {
      const color = santeColors[(8 + i) % santeColors.length];
      const checked = fondsChecked.has(e);
      const chip = document.createElement('label');
      chip.className = 'entity-chip detail-chip' + (checked ? ' checked' : '');
      chip.style.background = checked ? color : '';
      chip.style.borderColor = checked ? color : '';
      chip.innerHTML = `<input type="checkbox" value="${e}" ${checked?'checked':''}>${e}`;
      chip.querySelector('input').addEventListener('change', function() {
        if (this.checked) fondsChecked.add(e); else fondsChecked.delete(e);
        chip.classList.toggle('checked', this.checked);
        chip.style.background = this.checked ? color : '';
        chip.style.borderColor = this.checked ? color : '';
        updateSante();
      });
      fondsPicker.appendChild(chip);
    });
  }
}

function updateSante() {
  const grid = document.getElementById('santeChartsGrid');
  grid.innerHTML = '';
  const subtitle = `France AC+VC Â· ${santeLabel()}`;
  const labels = [], vals = [], colors = [], tableEntities = [];

  if (onuAggregated) {
    const v = santeGroupTotal('onu');
    if (v > 0) { labels.push('Total OI genevoises'); vals.push(v); colors.push(COLOR_ONU_AGG); }
    tableEntities.push({ label: 'Total OI genevoises', isAggregate: true, group: 'onu' });
  } else {
    santeONU.forEach((e, i) => {
      if (onuChecked.has(e)) {
        const v = santeGetAmount(e);
        labels.push(e); vals.push(v); colors.push(santeColors[(2+i) % santeColors.length]);
        tableEntities.push({ label: e, isAggregate: false, group: 'onu' });
      }
    });
  }

  if (fondsAggregated) {
    const v = santeGroupTotal('fonds');
    if (v > 0) { labels.push('Total fonds verticaux'); vals.push(v); colors.push(COLOR_FONDS_AGG); }
    tableEntities.push({ label: 'Total fonds verticaux', isAggregate: true, group: 'fonds' });
  } else {
    santeFonds.forEach((e, i) => {
      if (fondsChecked.has(e)) {
        const v = santeGetAmount(e);
        labels.push(e); vals.push(v); colors.push(santeColors[(8+i) % santeColors.length]);
        tableEntities.push({ label: e, isAggregate: false, group: 'fonds' });
      }
    });
  }

  if (labels.length === 0) {
    grid.innerHTML = '<p style="color:var(--text2);font-size:.85rem;padding:1rem 0;">Aucune entitÃ© sÃ©lectionnÃ©e.</p>';
    updateSanteTable(tableEntities);
    return;
  }

  const total = vals.reduce((a,b)=>a+b,0);
  const card = document.createElement('div');
  card.className = 'sante-pie-card';
  card.innerHTML = `
    <h3>RÃ©partition des contributions</h3>
    <div class="pie-year-label">${subtitle}</div>
    <div class="sante-pie-wrap"><canvas id="santePie1"></canvas></div>
    <div class="sante-total-row"><span>Total</span><strong>${fmtM(total)} USD</strong></div>
    <div class="sante-legend-grid" id="leg-santePie1"></div>`;
  grid.appendChild(card);

  const legEl = card.querySelector('#leg-santePie1');
  labels.forEach((l,i) => {
    const pct = total > 0 ? Math.round(vals[i]/total*100) : 0;
    legEl.innerHTML += `<span class="sante-legend-item"><span class="sante-legend-dot" style="background:${colors[i]}"></span>${l} (${pct}%)</span>`;
  });

  if (santePieChart) { try { santePieChart.destroy(); } catch(e){} }
  santePieChart = new Chart(document.getElementById('santePie1'), {
    type: 'doughnut',
    data: { labels, datasets: [{ data: vals, backgroundColor: colors, borderWidth: 2, borderColor: '#fff' }] },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: ctx => `${ctx.label}: ${fmt(ctx.raw)} USD (${total>0?Math.round(ctx.raw/total*100):0}%)` } }
      }
    }
  });
  updateSanteTable(tableEntities);
}

function updateSanteTable(entities) {
  const yearCols = [...santeYears, 'Total'];
  let html = `<thead><tr><th>EntitÃ©</th>`;
  yearCols.forEach(y => html += `<th>${y === 'Total' ? 'Total' : y}</th>`);
  html += `</tr></thead><tbody>`;

  const totals = {};
  santeYears.forEach(y => { totals[y] = 0; });
  totals.Total = 0;

  entities.forEach(item => {
    const yearVals = {};
    santeYears.forEach(y => { yearVals[y] = 0; });
    if (item.isAggregate) {
      const list = item.group === 'onu' ? santeONU : santeFonds;
      list.forEach(e => santeYears.forEach(y => { yearVals[y] += santeGetVal(e, y); }));
    } else {
      santeYears.forEach(y => { yearVals[y] = santeGetVal(item.label, y); });
    }
    const tot = santeYears.reduce((s, y) => s + yearVals[y], 0);
    santeYears.forEach(y => { totals[y] += yearVals[y]; });
    totals.Total += tot;
    const badge = item.isAggregate
      ? `<span style="color:#fff;font-size:.65rem;font-weight:700;background:${item.group==='onu'?COLOR_ONU_AGG:COLOR_FONDS_AGG};border-radius:4px;padding:1px 5px;margin-right:5px;">${item.group==='onu'?'OI':'VF'}</span>`
      : (santeFonds.includes(item.label) ? '<span style="color:#1a7a5e;font-size:.7rem;font-weight:600;margin-right:4px;">VF</span>' : '');
    html += `<tr><td>${badge}${item.label}</td>`;
    santeYears.forEach(y => { html += `<td>${fmt(yearVals[y])}</td>`; });
    html += `<td><strong>${fmt(tot)}</strong></td></tr>`;
  });

  if (entities.length > 0) {
    html += `<tr class="sante-total-row-tr"><td>Total sÃ©lection</td>`;
    santeYears.forEach(y => { html += `<td>${fmt(totals[y])}</td>`; });
    html += `<td><strong>${fmt(totals.Total)}</strong></td></tr>`;
  }
  html += '</tbody>';
  document.getElementById('santeTable').innerHTML = html;
}

function initSante() {
  onuAggregated = document.getElementById('sc-totalONU').checked;
  fondsAggregated = document.getElementById('sc-totalFonds').checked;
  if (!onuAggregated) santeONU.forEach(e => onuChecked.add(e));
  if (!fondsAggregated) santeFonds.forEach(e => fondsChecked.add(e));
  document.getElementById('santePieMode').addEventListener('change', updateSante);
  renderDetailChips();
  updateSante();
}

