// â”€â”€ CSV EXPORT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function csvEscape(val) {
  const s = String(val ?? '');
  return (s.includes(';') || s.includes('"') || s.includes('\n')) ? `"${s.replace(/"/g, '""')}"` : s;
}

function exportCsv() {
  const fy = filteredYears();
  const activeDonors = getActiveDonors();
  const activeOrgs = getActiveOrgs();
  const type = getType();
  const typeLabel = document.getElementById('typeSelect').selectedOptions[0].textContent;
  const orgLabel = getOrg() === 'all' ? 'Toutes les organisations' : getOrg();
  const donorLabel = (() => {
    const c = getCheckedDonors();
    if (c.length === donors.length) return 'Tous les pays';
    if (c.length === 0) return 'Aucun pays';
    if (c.length <= 3) return c.join(', ');
    return `${c.length} pays`;
  })();

  const lines = [
  `Type;${csvEscape(typeLabel)}`,
  `Pays donateurs;${csvEscape(donorLabel)}`,
  `Organisation;${csvEscape(orgLabel)}`,
  `PÃ©riode;${fy[0]} â€“ ${fy[fy.length - 1]}`,
  `Devise;USD`,
  '',
  ['Pays donateur', 'Organisation', ...fy.map(String)].join(';')
  ];

  const totals = fy.map(() => 0);
  activeDonors.forEach(donor => {
    activeOrgs.forEach(org => {
      const vals = fy.map((y, i) => {
        if (isNullVal(donor, org, y, type)) return 'N/D';
        const v = getVal(donor, org, y, type);
        totals[i] += v;
        return v === 0 ? '0' : String(v);
      });
      lines.push([csvEscape(donor), csvEscape(org), ...vals].join(';'));
    });
  });
  lines.push(['Total', '', ...totals.map(t => t === 0 ? '0' : String(t))].join(';'));

  const blob = new Blob(['\uFEFF' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `contributions-OI_${type}_${fy[0]}-${fy[fy.length - 1]}.csv`;
  a.click();
  URL.revokeObjectURL(a.href);
}

