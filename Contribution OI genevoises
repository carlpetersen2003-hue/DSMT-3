// â”€â”€ TABLE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function updateTable() {
  const fy = filteredYears();
  const activeDonors = getActiveDonors();
  const type = getType();
  const activeOrgs = getActiveOrgs();

  // Rows = donors Ã— orgs if multi-donor, else just orgs for single donor
  const singleDonor = getCheckedDonors().length === 1;

  const maxVals = {};
  fy.forEach(y => {
    let max = 0;
    activeDonors.forEach(d => {
      activeOrgs.forEach(o => { const v = getVal(d,o,y,type); if(v>max) max=v; });
    });
    maxVals[y] = max;
  });

  let html = `<thead><tr><th>${singleDonor ? 'Organisation' : 'Pays Â· Organisation'}</th>`;
  fy.forEach(y => { html += `<th>${y}</th>`; });
  html += `</tr></thead><tbody>`;

  const totals = {}; fy.forEach(y => { totals[y] = 0; });
  let hasNullTable = false;

  activeDonors.forEach(donor => {
    activeOrgs.forEach(org => {
      let cells = '';
      let rowTotal = 0;
      fy.forEach(y => {
        const isNull = isNullVal(donor, org, y, type);
        if (isNull) hasNullTable = true;
        const v = getVal(donor, org, y, type);
        totals[y] += v;
        rowTotal += v;
        const pct = maxVals[y] > 0 ? Math.round(v / maxVals[y] * 100) : 0;
        if (isNull) {
          cells += `<td class="bar-cell null-cell"><span class="null-badge">N/D</span></td>`;
        } else {
          cells += `<td class="bar-cell"><div>${fmtM(v)}</div><div class="bar-inner" style="width:${pct}%"></div></td>`;
        }
      });
      const label = singleDonor ? org : `${donor} Â· ${org}`;
      html += `<tr><td>${label}</td>${cells}</tr>`;
    });
  });

  html += `<tr class="total-row"><td>Total</td>`;
  fy.forEach(y => { html += `<td><b>${fmtM(totals[y])}</b></td>`; });
  html += `</tr></tbody>`;
  document.getElementById('dataTable').innerHTML = html;
  const tableNotice = document.getElementById('tableNullNotice');
  if (tableNotice) tableNotice.classList.toggle('visible', hasNullTable);
}

