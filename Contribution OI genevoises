function animateKPICounters() {
  const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduceMotion) {
    document.querySelectorAll('#kpiRow .kpi-val[data-final]').forEach(el => { el.textContent = el.dataset.final; });
    return;
  }
  document.querySelectorAll('#kpiRow .kpi-val[data-target]').forEach(el => {
    const target = parseFloat(el.dataset.target);
    const suffix = el.dataset.suffix || '';
    const isM    = el.dataset.fmt === 'M';
    const dur    = 600;
    const steps  = 30;
    const delay  = parseInt(el.dataset.delay || 0);
    let step = 0;
    setTimeout(() => {
      const interval = setInterval(() => {
        step++;
        const progress = step / steps;
        const ease = 1 - Math.pow(1 - progress, 3);
        const cur = target * ease;
        if (isM) {
          const m = cur / 1e6;
          el.textContent = (m >= 1000 ? (m/1000).toFixed(1) + ' Md' : m.toFixed(1) + ' M') + ' ' + suffix;
        } else {
          el.textContent = Math.round(cur) + suffix;
        }
        if (step >= steps) {
          clearInterval(interval);
          el.textContent = el.dataset.final;
        }
      }, dur / steps);
    }, delay);
  });
}

function ordinalFr(n) {
  if (n === 1) return '1er';
  return `${n}Ã¨me`;
}

function typeRankLabel(type) {
  if (type === 'TOTAL') return 'total';
  return type;
}

function updateKPI() {
  const fy = filteredYears();
  const activeDonors = getActiveDonors();
  const type = getType();
  const orgF = getOrg();
  const multiPeriod = fy.length > 1;
  const firstY = fy[0];
  const lastY  = fy[fy.length-1];

  // Totals for last year only
  let lastAC = 0, lastVC = 0;
  activeDonors.forEach(d => {
    (orgF === 'all' ? orgs : [orgF]).forEach(o => {
      lastAC += getVal(d, o, lastY, 'AC');
      lastVC += getVal(d, o, lastY, 'VC');
    });
  });

  // Totals for first year only (for % evolution)
  let firstAC = 0, firstVC = 0;
  activeDonors.forEach(d => {
    (orgF === 'all' ? orgs : [orgF]).forEach(o => {
      firstAC += getVal(d, o, firstY, 'AC');
      firstVC += getVal(d, o, firstY, 'VC');
    });
  });

  // Cumulative totals over full period
  let totalAC = 0, totalVC = 0;
  fy.forEach(y => {
    activeDonors.forEach(d => {
      (orgF === 'all' ? orgs : [orgF]).forEach(o => {
        totalAC += getVal(d, o, y, 'AC');
        totalVC += getVal(d, o, y, 'VC');
      });
    });
  });

  let lastTotal = lastAC + lastVC;
  let firstTotal = firstAC + firstVC;

  // Last year for selected type only
  let lastTyped = 0, firstTyped = 0;
  activeDonors.forEach(d => { lastTyped  += getDonorTotal(d, orgF, lastY, type); });
  activeDonors.forEach(d => { firstTyped += getDonorTotal(d, orgF, firstY, type); });

  function pctBadge(cur, ref) {
    if (!multiPeriod || ref === 0) return '';
    const pct = Math.round((cur - ref) / ref * 100);
    const sign = pct >= 0 ? '+' : '';
    const color = pct >= 0 ? 'var(--accent2)' : 'var(--ac-vc)';
    return `<div class="kpi-sub" style="color:${color};font-weight:500;">${sign}${pct}% depuis ${firstY}</div>`;
  }

  function kpiVal(value, cssClass) {
    const final = fmtM(value) + ' USD';
    return `<div class="kpi-val ${cssClass||''}" data-target="${value}" data-fmt="M" data-suffix="USD" data-final="${final}">${final}</div>`;
  }

  const donorLabel = (() => {
    const checked = getCheckedDonors();
    if (checked.length === donors.length) return `${donors.length} pays`;
    if (checked.length === 0) return 'Aucun pays';
    if (checked.length === 1) return checked[0];
    return `${checked.length} pays`;
  })();

  const checkedDonors = getCheckedDonors();
  let rankCard = '';
  if (checkedDonors.length === 1 && orgF !== 'all') {
    const donor = checkedDonors[0];
    const scores = donors.map(d => {
      if (isNullVal(d, orgF, lastY, type)) return null;
      const val = getVal(d, orgF, lastY, type);
      return val > 0 ? { donor: d, val } : null;
    }).filter(Boolean).sort((a, b) => b.val - a.val);
    const pos = scores.findIndex(x => x.donor === donor);
    if (pos >= 0) {
      const rank = pos + 1;
      const label = ordinalFr(rank);
      const typeLbl = typeRankLabel(type);
      rankCard = `
    <div class="kpi" style="border-left:3px solid var(--accent);">
      <div class="kpi-label">Classement Â· ${lastY}</div>
      <div class="kpi-val" style="font-size:1.25rem;line-height:1.35;">${donor} : ${label} donateur ${typeLbl} au ${orgF} en ${lastY}</div>
      <div class="kpi-sub">Classement Ã©tabli uniquement sur les ${donors.length} pays retenus dans cette page</div>
    </div>`;
    }
  }

  document.getElementById('kpiRow').innerHTML = `
    <div class="kpi">
      <div class="kpi-label">Total cumulÃ© (${firstY}â€“${lastY})</div>
      ${kpiVal(totalAC + totalVC)}
      <div class="kpi-sub">${donorLabel} Â· AC + VC</div>
    </div>
    <div class="kpi kpi-ac">
      <div class="kpi-label">AC â€” ${lastY}</div>
      ${kpiVal(lastAC)}
      ${pctBadge(lastAC, firstAC)}
      <div class="kpi-sub">${lastAC+lastVC > 0 ? Math.round(lastAC/(lastAC+lastVC)*100) : 0}% du total ${lastY}</div>
    </div>
    <div class="kpi kpi-vc">
      <div class="kpi-label">VC â€” ${lastY}</div>
      ${kpiVal(lastVC)}
      ${pctBadge(lastVC, firstVC)}
      <div class="kpi-sub">${lastAC+lastVC > 0 ? Math.round(lastVC/(lastAC+lastVC)*100) : 0}% du total ${lastY}</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">${type} â€” ${lastY}</div>
      ${kpiVal(lastTyped)}
      ${pctBadge(lastTyped, firstTyped)}
      <div class="kpi-sub">${orgF === 'all' ? orgs.length + ' organisations' : orgF}</div>
    </div>
    ${rankCard}
  `;

  animateKPICounters();
}

// â”€â”€ LINE CHART â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function updateLineChart() {
  const fy = filteredYears();
  const activeDonors = getActiveDonors();
  const type = getType();
  const orgF = getOrg();

  const singleDonor = getCheckedDonors().length === 1;

  let datasets = [];

  if (singleDonor) {
    // Single donor: show AC / VC / Total lines per org (or single total if org selected)
    if (orgF === 'all') {
      // One line per org
      const activeOrgs = orgs;
      activeOrgs.forEach((o, i) => {
        const vals = fy.map(y => chartVal(getDonor(), o, y, type));
        datasets.push({ label: o, data: vals, borderColor: orgColors[i], backgroundColor: orgColors[i]+'18', tension: 0.3, pointRadius: 4, pointHoverRadius: 6, borderWidth: 2, spanGaps: false });
      });
    } else {
      const acData = fy.map(y => chartVal(getDonor(), orgF, y, 'AC'));
      const vcData = fy.map(y => chartVal(getDonor(), orgF, y, 'VC'));
      const totData = fy.map(y => chartVal(getDonor(), orgF, y, 'TOTAL'));
      if (type !== 'VC') datasets.push({ label: 'AC', data: acData, borderColor: '#2c5f8a', backgroundColor: 'rgba(44,95,138,0.08)', tension: 0.3, pointRadius: 4, borderWidth: 2 });
      if (type !== 'AC') datasets.push({ label: 'VC', data: vcData, borderColor: '#8a2c2c', backgroundColor: 'rgba(138,44,44,0.08)', tension: 0.3, pointRadius: 4, borderWidth: 2 });
      if (type === 'TOTAL') datasets.push({ label: 'Total', data: totData, borderColor: '#b07d2a', backgroundColor: 'rgba(176,125,42,0.05)', tension: 0.3, pointRadius: 4, borderWidth: 2, borderDash: [6,3] });
    }
  } else {
    // All donors (or allExceptUS): one line per donor showing total across orgs
    activeDonors.forEach((d) => {
      const i = donors.indexOf(d);
      const vals = fy.map(y => {
        if (orgF !== 'all') return chartVal(d, orgF, y, type);
        const total = getDonorTotal(d, orgF, y, type);
        const hasNull = orgs.some(o => isNullVal(d, o, y, type));
        if (hasNull && total === 0) return null;
        return total || null;
      });
      datasets.push({ label: d, data: vals, borderColor: donorColors[i], backgroundColor: donorColors[i]+'18', tension: 0.3, pointRadius: 4, pointHoverRadius: 6, borderWidth: 2, spanGaps: false });
    });
  }

  let hasNullLine = false;
  activeDonors.forEach(d => {
    getActiveOrgs().forEach(o => {
      fy.forEach(y => { if (isNullVal(d, o, y, type)) hasNullLine = true; });
    });
  });
  const lineNotice = document.getElementById('lineNullNotice');
  if (lineNotice) lineNotice.classList.toggle('visible', hasNullLine);

  // Legend
  const legendEl = document.getElementById('lineLegend');
  legendEl.innerHTML = datasets.map((ds,i) => `<span><span class="dot" style="background:${ds.borderColor}"></span>${ds.label}</span>`).join('');

  if (lineChart) lineChart.destroy();
  lineChart = new Chart(document.getElementById('lineChart'), {
    type: 'line',
    data: { labels: fy, datasets },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => {
        if (ctx.raw === null || ctx.raw === undefined) return `${ctx.dataset.label}: âš  DonnÃ©e manquante`;
        return `${ctx.dataset.label}: ${fmt(ctx.raw)} USD`;
      } } } },
      scales: {
        y: { ticks: { callback: v => fmtM(v), font: { size: 11 } }, grid: { color: 'rgba(0,0,0,0.05)' } },
        x: { ticks: { font: { size: 11 } }, grid: { display: false } }
      }
    }
  });
  document.getElementById('chartTitle').textContent =
    `Ã‰volution â€” ${(() => { const c = getCheckedDonors(); return c.length === donors.length ? 'tous les pays' : c.length === 1 ? c[0] : c.length + ' pays'; })()} Â· ${getOrg() === 'all' ? 'toutes OI' : getOrg()} Â· ${type}`;
}

