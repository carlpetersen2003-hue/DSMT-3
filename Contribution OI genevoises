function adminCellChange(input) {
  const { type, donor, org, year } = input.dataset;
  const raw = input.value.trim();
  const val = raw === '' ? null : parseFloat(raw.replace(/\s/g, '').replace(',', '.'));
  if (raw !== '' && isNaN(val)) { input.classList.add('changed'); return; }
  if (!adminWorkingData.data[type]) adminWorkingData.data[type] = {};
  if (!adminWorkingData.data[type][donor]) adminWorkingData.data[type][donor] = {};
  if (!adminWorkingData.data[type][donor][org]) adminWorkingData.data[type][donor][org] = {};
  adminWorkingData.data[type][donor][org][year] = val;
  input.classList.add('changed');
}

function adminFxChange(input) {
  const idx = parseInt(input.dataset.fx);
  const field = input.dataset.field;
  const val = parseFloat(input.value.replace(',', '.'));
  if (!isNaN(val)) adminWorkingData.fxData[idx][field] = val;
  input.classList.add('changed');
}

function adminSanteCellChange(input) {
  const entity = input.dataset.santeEntity;
  const year = parseInt(input.dataset.santeYear);
