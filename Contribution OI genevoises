// â”€â”€ HELPERS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function getCheckedDonors() {
  return [...document.querySelectorAll('input[name="donor"]:checked')].map(el => el.value);
}
function getDonor()  {
  const checked = getCheckedDonors();
  if (checked.length === donors.length) return 'all';
  if (checked.length === donors.length - 1 && !checked.includes('Etats-Unis')) return 'allExceptUS';
  if (checked.length === 1) return checked[0];
  return 'multi';
}
function getOrg()    { return document.getElementById('orgSelect').value; }
function getType()   { return document.getElementById('typeSelect').value; }
function getYearFrom(){ return parseInt(document.getElementById('yearFrom').value); }
function getYearTo() { return parseInt(document.getElementById('yearTo').value); }
function filteredYears() { return years.filter(y => y >= getYearFrom() && y <= getYearTo()); }

function fmt(n)  { if (!n || isNaN(n)) return 'â€”'; return new Intl.NumberFormat('fr-FR',{maximumFractionDigits:0}).format(Math.round(n)); }
function fmtM(n) { if (!n || isNaN(n)) return 'â€”'; const m = n/1e6; if (m>=1000) return (m/1000).toFixed(1)+' Md'; return m.toFixed(1)+' M'; }

// Get value for a single donor+org+year combo (0 si absent ou null pour les agrÃ©gats)
function getVal(donor, org, year, type) {
  const d = data[type]?.[donor]?.[org]?.[String(year)];
  return (d == null || isNaN(d)) ? 0 : d;
}

// VÃ©rifie si la valeur brute est null (donnÃ©e manquante, distincte de zÃ©ro)
function isNullVal(donor, org, year, type) {
  const d = data[type]?.[donor]?.[org]?.[String(year)];
  return d === null || d === undefined;
}

function chartVal(donor, org, year, type) {
  return isNullVal(donor, org, year, type) ? null : Math.round(getVal(donor, org, year, type));
}

// Sum across orgs for a donor/year/type
function getDonorTotal(donor, orgFilter, year, type) {
  const orgList = orgFilter === 'all' ? orgs : [orgFilter];
  return orgList.reduce((s, o) => s + getVal(donor, o, year, type), 0);
}

// Active donors to display
function getActiveDonors() {
  const checked = getCheckedDonors();
  return checked.length > 0 ? checked : donors;
}

// Active orgs to display
function getActiveOrgs() {
  return getOrg() === 'all' ? orgs : [getOrg()];
}

